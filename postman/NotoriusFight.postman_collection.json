  "item": [
    {
      "name": "01 - Infraestrutura",
      "description": "Verifica se a aplicação está disponível antes dos cenários de negócio.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "Confirma que a aplicação recebeu e processou a requisição HTTP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Corpo OK', function () {",
                  "    pm.expect(pm.response.text()).to.eql('OK');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Documento OpenAPI JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs",
            "description": "Obtém o contrato OpenAPI processável por ferramentas."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Contrato identificado', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.info.title).to.eql('NotoriusFight API');",
                  "    pm.expect(body.paths).to.have.property('/api/artigos/{id}');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Documento OpenAPI YAML",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs.yaml",
            "description": "Obtém o mesmo contrato no formato YAML."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Documento YAML contém o título', function () {",
                  "    pm.expect(pm.response.text()).to.include('NotoriusFight API');",
                  "});"
                ]
              }
            }
          ]
        }
      ]

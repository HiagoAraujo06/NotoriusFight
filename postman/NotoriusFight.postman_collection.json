    {
      "name": "02 - Preparação dos cadastros",
      "description": "Cria os recursos utilizados pelas demais requisições e captura seus identificadores.",
      "item": [
        {
          "name": "Cadastrar categoria",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('categoriaNome', 'Categoria Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Location informado', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('categoriaId', body.id);",
                  "pm.test('Categoria criado e ativo', function () {",
                  "    pm.expect(body.nome).to.eql(pm.collectionVariables.get('categoriaNome'));",
                  "    pm.expect(body.status).to.eql('ATIVO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{categoriaNome}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/categorias",
            "description": "Cria uma categoria ativa com nome único."
          }
        },
        {
          "name": "Cadastrar fornecedor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fornecedorCnpj', String(Date.now()).slice(-13) + '0');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('fornecedorId', body.id);",
                  "pm.test('Fornecedor criado', function () {",
                  "    pm.expect(body.cnpj).to.eql(pm.collectionVariables.get('fornecedorCnpj'));",
                  "    pm.expect(body.status).to.eql('ATIVO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razaoSocial\": \"Fornecedor criado pelo Postman\",\n  \"cnpj\": \"{{fornecedorCnpj}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/fornecedores",
            "description": "Cria um fornecedor com CNPJ fictício de 14 dígitos."
          }
        },
        {
          "name": "Cadastrar artigo",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('artigoCodigo', 'POSTMAN-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('artigoId', body.id);",
                  "pm.test('Artigo criado com relacionamentos', function () {",
                  "    pm.expect(body.sku).to.eql(pm.collectionVariables.get('artigoCodigo'));",
                  "    pm.expect(String(body.categoriaId)).to.eql(String(pm.collectionVariables.get('categoriaId')));",
                  "    pm.expect(String(body.fornecedorId)).to.eql(String(pm.collectionVariables.get('fornecedorId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sku\": \"{{artigoCodigo}}\",\n  \"descricao\": \"Artigo criado pelo Postman\",\n  \"saldoEstoque\": 10.000,\n  \"valorUnitario\": 49.90,\n  \"estoqueMinimo\": 2.000,\n  \"categoriaId\": {{categoriaId}},\n  \"fornecedorId\": {{fornecedorId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/artigos",
            "description": "Cria um artigo associado à categoria e ao fornecedor criados anteriormente."
          }
        }
      ]
    },
